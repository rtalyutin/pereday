VITE_API_MODE=demo
VITE_CAMPAIGN_SLUG=peredai
# Production: npm run build:production sets VITE_API_MODE=live at build time.
# VITE_CAMPAIGN_SLUG must match PEREDAI_CAMPAIGN_SLUG and the campaign in PostgreSQL.
# VITE_CTA_TARGET=https://your-brand.example/contact

# Backend: set these in your environment, never commit actual secrets.
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/peredai
# PEREDAI_PUBLIC_ORIGIN=http://127.0.0.1:5173
# PORT=8787  # hosting port; PEREDAI_PORT is an alternative and must match if both are set
# PEREDAI_BIND_HOST=127.0.0.1  # use 0.0.0.0 behind an HTTPS ingress
# PEREDAI_CAMPAIGN_SLUG=peredai
# PEREDAI_CURSOR_SECRET=<random-secret>
# PEREDAI_CSRF_SECRET=<different-random-secret>
# PEREDAI_SESSION_TTL_SECONDS=<positive-integer>
# PEREDAI_MAX_BODY_BYTES=<positive-integer>
# PEREDAI_PAGE_LIMIT=<positive-integer>
# PEREDAI_RATE_WINDOW_SECONDS=<positive-integer>
# PEREDAI_SESSION_RATE_LIMIT=<positive-integer>
# PEREDAI_WRITE_RATE_LIMIT=<positive-integer>
# PEREDAI_RATE_LIMIT_MODE=trusted-proxy  # HTTPS: trusted-proxy or ingress
# PEREDAI_TRUSTED_PROXY_ADDRESSES=127.0.0.1  # trusted-proxy only; ingress must overwrite X-Forwarded-For
# PEREDAI_SHUTDOWN_GRACE_SECONDS=<positive-integer>
# PEREDAI_MAX_CREATURES=<positive-integer>
# PEREDAI_BRAND=<approved-brand>
# PEREDAI_OFFER=<approved-offer>
# PEREDAI_CTA_TARGET=<approved-https-url>
# PEREDAI_ALLOW_PARTIAL_DEMO=1  # only on loopback; steps 5–16 still unavailable
# PEREDAI_STAGING=1  # only for server:seed-staging on an isolated *_staging PostgreSQL database
