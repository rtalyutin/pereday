{
  "name": "peredai-rebuild",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsc --project server/tsconfig.json",
    "build:production": "VITE_API_MODE=live npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts server/tests/*.test.ts",
    "server:dev": "node --import tsx server/main.ts",
    "server:start": "node server-dist/main.js",
    "start:production": "node server-dist/production.js",
    "server:migrate": "node --import tsx server/migrate.ts",
    "server:seed-demo": "node --import tsx server/seed-demo.ts",
    "server:seed-staging": "node server-dist/seed-staging.js"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "24.10.1",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "^30.1.1",
    "tsx": "4.21.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
